# MongoDB connection string (e.g. MongoDB Atlas cluster or local MongoDB)
# If not configured or unreachable, the system automatically uses an in-memory
# repository with preloaded seed data.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/librhub_db?retryWrites=true&w=majority"

# JWT secret used to sign librarian session tokens
JWT_SECRET="librhub_jwt_secure_secret_key_2026_super_secure"

# Client URL for CORS policy
CLIENT_URL="http://localhost:3000"

# Application port
PORT=3000
NODE_ENV="development"
